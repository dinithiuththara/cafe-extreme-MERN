# ===========================================
# CAFÉ EXTREME — Environment Variables
# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file.
# ===========================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local:      mongodb://127.0.0.1:27017/cafe-extreme
# Atlas:      mongodb+srv://<user>:<password>@cluster.mongodb.net/cafe-extreme
MONGO_URI=mongodb+srv://cafeadmin:1234@cluster0.te9wda1.mongodb.net/?appName=Cluster0

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Admin seed account (used by server/seed/seedAdmin.js) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@cafeextreme.com
ADMIN_PASSWORD=123456

# --- Payments (Stripe) ---
# Leave blank during development to automatically use DEMO payment mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Client (Vite) ---
# These go in client/.env instead (must be prefixed with VITE_)
# VITE_API_URL=http://localhost:5000/api
# VITE_STRIPE_PUBLISHABLE_KEY=
